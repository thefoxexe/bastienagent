# Telegram Bot Token (obtenu via @BotFather sur Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ton Telegram User ID (pour sécuriser l'accès — seul toi peux utiliser le bot)
# Envoie /start à @userinfobot pour l'obtenir
TELEGRAM_USER_ID=your_user_id_here

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Météo — OpenWeatherMap (gratuit)
OPENWEATHER_API_KEY=your_openweather_key_here
CITY=Geneva

# Fuseau horaire
TIMEZONE=Europe/Zurich

# Heure du briefing quotidien (format HH:MM)
BRIEFING_TIME=07:30

# Google Calendar — après avoir fait le flow OAuth, les tokens sont sauvés automatiquement
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
